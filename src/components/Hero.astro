---
import Knap from "./Knap.astro";
import "../css/global.css";
---

<section class="hero">
  <div class="hero-image">
    <img src="/images/hero.webp" alt="hero foto" />
    <div class="hero-text">
      <h1>Dele-tøj på abonnement</h1>
      <p>Hos Another Closet har vi skabt et socialt og bæredygtigt klædeskab, hvor du for 149,-/mdr. kan låne 3 unikke stykker tøj.</p>
      <Knap indhold="Find dit lokale klædeskab her!" href="#find-klaedeskab" color="black" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-image {
    position: relative;
    width: 100%;
    height: 60%;
    overflow: hidden;
  }

  .hero-image img {
    aspect-ratio: 2.65 / 1;
    width: 100%;
    object-fit: cover;
    display: block;
    /* width: 100%;
    height: 100%;
    inset: 0; */
  }

  /* Tekst ovenpå billedet */
  .hero-text {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    text-align: right;
    max-width: 40%;
    color: black;
    padding: 2rem;
  }

  .hero-text h1 {
    margin-bottom: 2rem;
  }

  .hero-text p {
    margin-bottom: 2rem;
  }

  .hero-text .cta {
    font-family: "futura-pt", Arial, Helvetica, sans-serif;
    font-size: 1.25rem;
    font-weight: 100;
    color: black;
    text-decoration: none;
    transition: text-decoration 0.2s ease;
  }

  .hero-text .cta:hover {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  /* Mobil layout */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-text {
      position: static;
      transform: none;
      background: none;
      text-align: left;
      max-width: 100%;
      padding: 2rem 1.5rem;
    }

    .hero-text h1 {
      text-align: left;
    }

    .hero-text .cta {
      font-size: 1rem;
    }
  }
</style>
