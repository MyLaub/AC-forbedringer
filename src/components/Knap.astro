---
const {
  indhold = "knap",
  href = "#",
  color = "black", // 'black', 'rød' eller 'brun'
} = Astro.props;
---

<a href={href} class={`button ${color}`}>{indhold}</a>

<style>
  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-family: "futura-pt";
    font-weight: normal;
    font-size: 1.2rem;
    text-decoration: none;
    border-radius: 999px;
    width: fit-content;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.3s ease-in-out,
      color 0.2s ease;
  }

  /* Farver */
  .black {
    border: 1.5px solid black;
    color: black;
    background: transparent;
  }
  .black:hover {
    background: black;
    color: white;
  }

  .rød {
    border: 1.5px solid var(--rød);
    color: var(--rød);
    background: transparent;
  }
  .rød:hover {
    background: var(--rød);
    color: white;
  }

  .brun {
    border: 1.5px solid white;
    color: white;
    background: transparent;
  }
  .brun:hover {
    background: white;
    color: var(--brun);
  }
</style>
