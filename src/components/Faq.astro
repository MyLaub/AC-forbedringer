---
import Knap from "./Knap.astro";
---

<section class="faq-sektion">
  <div class="faq-indhold">
    <ul class="faq-spoergsmaal">
      <li>“ Er der tøj i alle størrelser? ”</li>
      <li>“ Kan jeg frit vælge, hvad jeg vil låne? ”</li>
      <li>“ Får jeg mit eget udlånte tøj tilbage igen? ”</li>
      <li>“ Hvad hvis tøjet går i stykker? ”</li>
      <li>“ Hvad med vask? ”</li>
    </ul>
    <Knap indhold="Klik her og bliv klogere!" href="/" color="brun" />
  </div>

  <div class="faq-tekst">
    <h4 class="faq-logo">FAQ</h4>
  </div>
</section>

<style>
  .faq-sektion {
    display: grid;
    grid-template-columns: 1fr auto;
    background-color: var(--brun);
    color: white;
    padding: 4rem 4rem 2rem 4rem;
    align-items: stretch;
  }

  .faq-indhold {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  .faq-spoergsmaal {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: "futura-pt";
    font-size: 1.25rem;
    font-style: italic;
  }

  .faq-spoergsmaal li {
    margin-bottom: 0.5rem;
  }

  .faq-tekst {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
    align-self: stretch;
    padding-bottom: 0;
  }

  .faq-logo {
    font-family: "CCMetcon Heavy", sans-serif;
    font-size: 8rem;
    margin: 0;
    color: white;
    margin-bottom: -3.8rem;
  }

  /* Mobil layout */

  @media (max-width: 768px) {
    .faq-sektion {
      display: flex;
      flex-direction: column;
      padding: 4rem 2rem 2rem 2rem;
    }

    .faq-indhold {
      order: 1;
      align-items: flex-start;
      text-align: left;
      gap: 1rem;
    }

    .faq-tekst {
      order: 2;
      display: flex;
      justify-content: flex-end;
      padding: 0;
    }

    .faq-logo {
      padding-top: 1.8rem;
      font-size: 5rem;
      margin-bottom: -3.2rem;
    }

    .faq-spoergsmaal {
      font-size: 1.2rem;
      line-height: 1.6;
    }
  }
</style>
